#!/usr/bin/env python3
"""codex-cua: drive local macOS apps through Codex Computer Use from the shell.

Codex ships Computer Use as an MCP server (`SkyComputerUseClient mcp`), but the
service refuses connections whose parent/responsible process is not signed by
OpenAI's team id, so spawning it from a shell fails with
"Sender process is not authenticated". This CLI therefore runs it the way Codex
does: `codex app-server` hosts the MCP server and we call tools through
`mcpServer/tool/call`.

A background session daemon keeps one app-server + thread alive so repeated
commands cost well under a second instead of re-paying app-server startup.
"""

from __future__ import annotations

import argparse
import base64
import ctypes
import fcntl
import hashlib
import hmac
import json
import os
import queue
import re
import secrets
import shutil
import signal
import socket
import stat
import struct
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import NamedTuple

VERSION = "0.2.0"
SERVER_NAME = "computer-use"
DEFAULT_TIMEOUT = 180.0
IPC_VERSION = 2
IPC_AUTH_TIMEOUT = 5.0
IPC_MAX_FRAME = 1 << 20
# Tool replies can include a base64 screenshot. Keep them bounded, but allow
# substantially more space than a request or authentication frame.
IPC_MAX_REPLY_FRAME = 16 << 20
IPC_MAX_TIMEOUT = 600.0
IPC_MAX_MATCH_PATTERN = 4096
UNIX_SOCKET_PATH_MAX = 104
PRIVATE_DIR_MODE = 0o700
PRIVATE_FILE_MODE = 0o600
OPENAI_TEAM_ID = "2DC432GLL2"

TOOLS = {
    "list_apps": (),
    "get_app_state": ("app",),
    "click": ("app",),
    "perform_secondary_action": ("app", "element_index", "action"),
    "set_value": ("app", "element_index", "value"),
    "select_text": ("app", "element_index", "text"),
    "scroll": ("app", "direction", "element_index"),
    "drag": ("app", "from_x", "from_y", "to_x", "to_y"),
    "press_key": ("app", "key"),
    "type_text": ("app", "text"),
}

# Tools that need an app-use session, i.e. a get_app_state for that app first.
INTERACTION_TOOLS = {
    "click",
    "perform_secondary_action",
    "set_value",
    "select_text",
    "scroll",
    "drag",
    "press_key",
    "type_text",
}


def tree_matches(text: str, pattern: str, case_sensitive: bool = False) -> list[tuple[str, str]]:
    """Return (element_index, line) for accessibility-tree lines matching pattern."""
    try:
        compiled = re.compile(pattern, 0 if case_sensitive else re.IGNORECASE)
    except re.error as exc:
        raise SystemExit(f"bad pattern: {exc}")
    matches = []
    for line in text.splitlines():
        stripped = line.strip()
        if not compiled.search(stripped):
            continue
        index = stripped.split(" ", 1)[0]
        if index.isdigit():
            matches.append((index, stripped))
    return matches


def codex_bin() -> str:
    explicit = os.environ.get("CODEX_BIN")
    if explicit:
        return explicit
    candidates = [
        "/Applications/ChatGPT.app/Contents/Resources/codex",
        str(Path.home() / ".codex" / "bin" / "codex"),
    ]
    found = shutil.which("codex")
    if found:
        candidates.append(found)
    for c in candidates:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    raise SystemExit(
        "codex CLI not found. Install the Codex/ChatGPT desktop app or set CODEX_BIN."
    )


def computer_use_app() -> Path:
    explicit = os.environ.get("CODEX_CUA_APP")
    if explicit:
        return Path(explicit)
    candidates = [
        Path.home() / ".codex" / "computer-use" / "Codex Computer Use.app",
        Path.home()
        / ".codex"
        / "plugins"
        / "openai-bundled"
        / "plugins"
        / "computer-use"
        / "Codex Computer Use.app",
        Path("/Applications/ChatGPT.app/Contents/Resources/plugins/openai-bundled/plugins/computer-use/Codex Computer Use.app"),
    ]
    for c in candidates:
        if c.is_dir():
            return c
    raise SystemExit(
        "Codex Computer Use.app not found. Enable Computer Use in the Codex app, "
        "or set CODEX_CUA_APP to the bundle path."
    )


def mcp_client_path(app: Path) -> Path:
    return app / "Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient"


class IPCError(RuntimeError):
    """A local session protocol or peer-authentication failure."""


class PeerAuthenticationError(IPCError):
    """The kernel or protocol did not authenticate an IPC peer."""


class PeerIdentity(NamedTuple):
    """Identity facts obtained from the kernel, not from request JSON."""

    uid: int
    pid: int | None
    audit_uid: int | None
    audit_pid: int | None
    team_id: str | None
    identifier: str | None


class SessionInfo(NamedTuple):
    """The authenticated endpoint metadata for one daemon session."""

    endpoint: Path
    session_dir: Path
    socket_path: Path
    auth_path: Path
    pid: int
    token: bytes


def _private_stat(path: Path, *, directory: bool) -> os.stat_result:
    """Return a safe lstat result, rejecting symlinks and foreign owners."""
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        raise IPCError(f"private {'directory' if directory else 'file'} is missing: {path}")
    expected_type = stat.S_ISDIR if directory else stat.S_ISREG
    if not expected_type(info.st_mode):
        raise IPCError(f"private path is not a {'directory' if directory else 'regular file'}: {path}")
    if info.st_uid != os.getuid():
        raise IPCError(f"private path has unexpected owner: {path}")
    if directory and stat.S_IMODE(info.st_mode) != PRIVATE_DIR_MODE:
        raise IPCError(f"private directory is not mode 0700: {path}")
    return info


def _validate_parent_chain(path: Path) -> None:
    """Reject writable ancestors that could replace the state directory."""
    probe = path.parent
    while not probe.exists() and probe != probe.parent:
        probe = probe.parent
    while True:
        try:
            info = os.stat(probe)
        except OSError as exc:
            raise IPCError(f"cannot inspect state parent {probe}") from exc
        mode = stat.S_IMODE(info.st_mode)
        if not stat.S_ISDIR(info.st_mode):
            raise IPCError(f"state parent is not a directory: {probe}")
        if mode & 0o022 and not (mode & stat.S_ISVTX):
            raise IPCError(f"state parent is writable by another account: {probe}")
        if probe == probe.parent:
            return
        probe = probe.parent


def _default_state_dir() -> Path:
    return Path(os.path.abspath(Path.home() / ".cache" / "codex-cua"))


def _create_private_parents(path: Path) -> None:
    missing: list[Path] = []
    probe = path
    while not probe.exists() and probe != probe.parent:
        missing.append(probe)
        probe = probe.parent
    for directory in reversed(missing):
        try:
            directory.mkdir(mode=PRIVATE_DIR_MODE)
        except FileExistsError:
            pass
        except OSError as exc:
            raise IPCError(f"cannot create private state directory {directory}: {exc}") from exc
        try:
            _private_stat(directory, directory=True)
        except IPCError as exc:
            raise IPCError(f"new state directory is not private: {directory}") from exc


def _secure_state_dir(path: Path) -> Path:
    info = os.lstat(path)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise IPCError(f"private path is not an owned directory: {path}")
    mode = stat.S_IMODE(info.st_mode)
    if mode != PRIVATE_DIR_MODE:
        # Only the app-owned default directory is upgraded in place. A custom
        # path may be a shared/system directory, so reject it instead of
        # changing permissions outside our control.
        if path != _default_state_dir():
            raise IPCError(f"state directory must be mode 0700: {path}")
        try:
            os.chmod(path, PRIVATE_DIR_MODE, follow_symlinks=False)
        except OSError as exc:
            raise IPCError(f"cannot secure state directory {path}: {exc}") from exc
        info = _private_stat(path, directory=True)
        if stat.S_IMODE(info.st_mode) != PRIVATE_DIR_MODE:
            raise IPCError(f"state directory is not mode 0700: {path}")
    return path


def _ensure_private_dir(path: Path) -> Path:
    """Create a state directory and make its ownership and mode explicit."""
    path = Path(os.path.abspath(path.expanduser()))
    _validate_parent_chain(path)
    _create_private_parents(path)
    if not path.exists():
        raise IPCError(f"private state directory was not created: {path}")
    return _secure_state_dir(path)


def _private_file_fd(
    path: Path,
    flags: int,
    *,
    mode: int = PRIVATE_FILE_MODE,
    repair_mode: bool = False,
) -> int:
    """Open a private file without following a symlink, then verify its fd."""
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    cloexec = getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(path, flags | nofollow | cloexec, mode)
    except OSError as exc:
        raise IPCError(f"cannot open private file {path}: {exc}") from exc
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            raise IPCError(f"private path has unexpected type or owner: {path}")
        actual_mode = stat.S_IMODE(info.st_mode)
        if actual_mode != mode:
            if not repair_mode:
                raise IPCError(f"private file is not mode {mode:04o}: {path}")
            os.fchmod(fd, mode)
        return fd
    except Exception:
        os.close(fd)
        raise


def _unlink_best_effort(path: Path) -> None:
    try:
        path.unlink(missing_ok=True)
    except OSError:
        pass


def _write_private(path: Path, data: bytes, *, replace: bool = False) -> None:
    """Write a bounded private file atomically."""
    parent = path.parent
    _ensure_private_dir(parent)
    if replace:
        temporary = parent / f".{path.name}.{secrets.token_hex(12)}.tmp"
        try:
            fd = _private_file_fd(
                temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, repair_mode=True
            )
            try:
                with os.fdopen(fd, "wb", closefd=True) as stream:
                    stream.write(data)
                    stream.flush()
                    os.fsync(stream.fileno())
                os.replace(temporary, path)
            except Exception:
                _unlink_best_effort(temporary)
                raise
        finally:
            _unlink_best_effort(temporary)
        return
    fd = _private_file_fd(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, repair_mode=True)
    with os.fdopen(fd, "wb", closefd=True) as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())


def _read_private(path: Path, *, limit: int = IPC_MAX_FRAME) -> bytes:
    """Read a private regular file through a no-follow descriptor."""
    fd = _private_file_fd(path, os.O_RDONLY)
    try:
        data = os.read(fd, limit + 1)
    finally:
        os.close(fd)
    if len(data) > limit:
        raise IPCError(f"private file is too large: {path}")
    return data


def state_dir() -> Path:
    return _ensure_private_dir(_configured_state_root())


def _configured_state_root() -> Path:
    configured = os.environ.get("CODEX_CUA_HOME") or _default_state_dir()
    return Path(os.path.abspath(Path(configured).expanduser()))


def _configured_state_path(name: str) -> Path:
    return _configured_state_root() / name


# These names remain exported for scripts that imported the old constants. The
# daemon never uses the legacy socket; new sessions resolve through endpoint_path.
LEGACY_SOCKET_PATH = _configured_state_path("session.sock")
SOCKET_PATH = LEGACY_SOCKET_PATH
PID_PATH = _configured_state_path("session.pid")
LOG_PATH = _configured_state_path("session.log")
ENDPOINT_PATH = _configured_state_path("session.json")
LOCK_PATH = _configured_state_path("session.lock")
START_LOCK_FD_ENV = "CODEX_CUA_START_LOCK_FD"


def endpoint_path() -> Path:
    return state_dir() / ENDPOINT_PATH.name


def pid_path() -> Path:
    return state_dir() / PID_PATH.name


def log_path() -> Path:
    return state_dir() / LOG_PATH.name


def lock_path() -> Path:
    return state_dir() / LOCK_PATH.name


def _sockopt_bytes(conn: socket.socket, option: int, size: int) -> bytes | None:
    """Read a Darwin local-socket option as bytes, if the OS exposes it."""
    try:
        value = conn.getsockopt(getattr(socket, "SOL_LOCAL", 0), option, size)
    except (AttributeError, OSError):
        return None
    if isinstance(value, bytes):
        return value
    if isinstance(value, int):
        return struct.pack("=i", value)
    return None


def _audit_identity(raw: bytes) -> tuple[int | None, int | None]:
    """Extract euid and pid with Apple's libbsm audit-token API."""
    if len(raw) < 32:
        return None, None

    class AuditToken(ctypes.Structure):
        _fields_ = [("val", ctypes.c_uint32 * 8)]

    try:
        token = AuditToken.from_buffer_copy(raw[:32])
        bsm = ctypes.CDLL("/usr/lib/libbsm.0.dylib")
        euid = bsm.audit_token_to_euid
        pid = bsm.audit_token_to_pid
        euid.argtypes = [AuditToken]
        euid.restype = ctypes.c_uint32
        pid.argtypes = [AuditToken]
        pid.restype = ctypes.c_int32
        return int(euid(token)), int(pid(token))
    except (AttributeError, OSError, TypeError, ValueError):
        return None, None


def _cf_string(cf: ctypes.CDLL, value: int | None) -> str | None:
    """Convert a CoreFoundation string pointer without dereferencing NULL."""
    if not value:
        return None
    buffer = ctypes.create_string_buffer(256)
    try:
        get_string = cf.CFStringGetCString
        get_string.argtypes = [
            ctypes.c_void_p,
            ctypes.c_char_p,
            ctypes.c_long,
            ctypes.c_uint32,
        ]
        get_string.restype = ctypes.c_bool
        ok = get_string(ctypes.c_void_p(value), buffer, len(buffer), 0x08000100)
    except (OSError, TypeError, ValueError):
        return None
    return buffer.value.decode("utf-8", "replace") if ok else None


def _signing_identity(pid: int | None) -> tuple[str | None, str | None]:
    """Read a live process team and identifier through Security.framework.

    The audit token is kernel supplied. Security.framework still takes a PID,
    so this is an informational/allow-list check rather than a replacement for
    the token and UID checks. A caller can opt into strict team enforcement with
    CODEX_CUA_ALLOWED_TEAM_IDS or CODEX_CUA_REQUIRE_TEAM_ID.
    """
    if pid is None or pid <= 0 or sys.platform != "darwin":
        return None, None
    try:
        security = ctypes.CDLL("/System/Library/Frameworks/Security.framework/Security")
        core_foundation = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
        number = core_foundation.CFNumberCreate
        dictionary = core_foundation.CFDictionaryCreate
        get_value = core_foundation.CFDictionaryGetValue
        release = core_foundation.CFRelease
        number.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p]
        number.restype = ctypes.c_void_p
        dictionary.argtypes = [
            ctypes.c_void_p,
            ctypes.POINTER(ctypes.c_void_p),
            ctypes.POINTER(ctypes.c_void_p),
            ctypes.c_long,
            ctypes.c_void_p,
            ctypes.c_void_p,
        ]
        dictionary.restype = ctypes.c_void_p
        get_value.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        get_value.restype = ctypes.c_void_p
        release.argtypes = [ctypes.c_void_p]
        copy_guest = security.SecCodeCopyGuestWithAttributes
        copy_guest.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint32, ctypes.POINTER(ctypes.c_void_p)]
        copy_guest.restype = ctypes.c_int32
        check_validity = security.SecCodeCheckValidity
        check_validity.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_void_p]
        check_validity.restype = ctypes.c_int32
        copy_signing = security.SecCodeCopySigningInformation
        copy_signing.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.POINTER(ctypes.c_void_p)]
        copy_signing.restype = ctypes.c_int32

        pid_value = ctypes.c_int32(pid)
        pid_number = number(None, 3, ctypes.byref(pid_value))
        if not pid_number:
            return None, None
        guest = ctypes.c_void_p()
        attributes_key = ctypes.c_void_p.in_dll(security, "kSecGuestAttributePid")
        keys = (ctypes.c_void_p * 1)(attributes_key)
        values = (ctypes.c_void_p * 1)(pid_number)
        attributes = dictionary(None, keys, values, 1, None, None)
        if not attributes:
            release(pid_number)
            return None, None
        try:
            if copy_guest(None, attributes, 0, ctypes.byref(guest)) != 0 or not guest.value:
                return None, None
            # A failed validity check means an unsigned or invalid process. In
            # either case there is no trusted team to add to the allow-list.
            if check_validity(guest, 0, None) != 0:
                return None, None
            information = ctypes.c_void_p()
            if copy_signing(guest, 2, ctypes.byref(information)) != 0 or not information.value:
                return None, None
            try:
                team_key = ctypes.c_void_p.in_dll(security, "kSecCodeInfoTeamIdentifier")
                identifier_key = ctypes.c_void_p.in_dll(security, "kSecCodeInfoIdentifier")
                team = _cf_string(core_foundation, get_value(information, team_key))
                identifier = _cf_string(core_foundation, get_value(information, identifier_key))
                return team, identifier
            finally:
                release(information)
        finally:
            if guest.value:
                release(guest)
            release(attributes)
            release(pid_number)
    except (AttributeError, OSError, TypeError, ValueError):
        return None, None


def peer_identity(conn: socket.socket) -> PeerIdentity:
    """Read and validate kernel credentials for a connected local socket."""
    peercred_option = getattr(socket, "LOCAL_PEERCRED", 1)
    raw_cred = _sockopt_bytes(conn, peercred_option, 256)
    if not raw_cred or len(raw_cred) < 8:
        raise PeerAuthenticationError("kernel peer credentials are unavailable")
    uid = struct.unpack_from("=I", raw_cred, 4)[0]

    peer_pid_option = getattr(socket, "LOCAL_PEERPID", 2)
    raw_pid = _sockopt_bytes(conn, peer_pid_option, 4)
    pid = struct.unpack("=i", raw_pid[:4])[0] if raw_pid and len(raw_pid) >= 4 else None
    if pid is not None and pid <= 0:
        raise PeerAuthenticationError("kernel returned an invalid peer pid")

    # Python 3.11 and 3.14 omit this Darwin constant. The value is
    # LOCAL_PEERTOKEN 0x006 in Apple's sys/un.h (MacOSX15 and MacOSX26 SDKs).
    token_option = getattr(socket, "LOCAL_PEERTOKEN", 0x006)
    raw_token = _sockopt_bytes(conn, token_option, 32)
    audit_uid, audit_pid = _audit_identity(raw_token or b"")
    if raw_token and (audit_uid is None or audit_pid is None):
        raise PeerAuthenticationError("peer audit token could not be verified")
    if audit_uid is not None and audit_uid != uid:
        raise PeerAuthenticationError("peer credential and audit token disagree")
    if audit_pid is not None and pid is not None and audit_pid != pid:
        raise PeerAuthenticationError("peer pid and audit token disagree")
    if sys.platform == "darwin" and (
        pid is None or audit_uid is None or audit_pid is None
    ):
        raise PeerAuthenticationError("macOS did not provide a complete peer identity")
    # Resolving a code signature is comparatively expensive. The kernel audit
    # token and HMAC are always checked; ask Security.framework only when the
    # caller enabled a team policy that can use the result.
    team, identifier = (None, None)
    if _allowed_team_ids() or _team_required():
        team, identifier = _signing_identity(pid or audit_pid)
    return PeerIdentity(uid, pid or audit_pid, audit_uid, audit_pid, team, identifier)


def _allowed_team_ids() -> set[str]:
    raw = os.environ.get("CODEX_CUA_ALLOWED_TEAM_IDS", "")
    return {item.strip() for item in raw.split(",") if item.strip()}


def _team_required() -> bool:
    return os.environ.get("CODEX_CUA_REQUIRE_TEAM_ID", "").strip().lower() in {"1", "true", "yes"}


def authorize_peer(identity: PeerIdentity, *, expected_pid: int | None = None) -> None:
    """Apply UID, PID, and optional code-signing policy to a peer."""
    current_uid = os.getuid()
    if identity.uid != current_uid:
        raise PeerAuthenticationError("peer is not running as the current user")
    if expected_pid is not None and identity.pid != expected_pid:
        raise PeerAuthenticationError("peer pid does not match the session endpoint")
    allowed = _allowed_team_ids()
    if allowed and identity.team_id not in allowed:
        presented = identity.team_id or "unsigned"
        raise PeerAuthenticationError(f"peer team {presented!r} is not allowed")
    if _team_required() and not identity.team_id:
        raise PeerAuthenticationError("a signed peer team identifier is required")


class AppServer:
    """Speaks the Codex app-server JSON-RPC protocol over stdio."""

    def __init__(self, verbose: bool = False):
        self.verbose = verbose
        self.proc: subprocess.Popen | None = None
        self.inbox: queue.Queue = queue.Queue()
        self.next_id = 0
        self.thread_id: str | None = None
        self.lock = threading.Lock()

    def start(self) -> None:
        app = computer_use_app()
        client = mcp_client_path(app)
        if not client.is_file():
            raise SystemExit(f"Computer Use MCP client missing at {client}")
        args = [
            codex_bin(),
            "app-server",
            "--stdio",
            "-c",
            f"mcp_servers.{SERVER_NAME}.enabled=true",
            "-c",
            f"mcp_servers.{SERVER_NAME}.command={json.dumps(str(client))}",
            "-c",
            f'mcp_servers.{SERVER_NAME}.args=["mcp"]',
            "-c",
            f"mcp_servers.{SERVER_NAME}.cwd={json.dumps(str(app.parent))}",
            "-c",
            f"mcp_servers.{SERVER_NAME}.startup_timeout_sec=60",
        ]
        self.proc = subprocess.Popen(
            args,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
        threading.Thread(target=self._read_stdout, daemon=True).start()
        threading.Thread(target=self._read_stderr, daemon=True).start()
        self.request(
            "initialize",
            {
                "clientInfo": {"name": "codex-cua", "version": VERSION},
                "capabilities": {"experimentalApi": True},
            },
        )
        self.notify("initialized")
        started = self.request(
            "thread/start",
            {"cwd": os.getcwd(), "ephemeral": True, "serviceName": "codex-cua"},
        )
        self.thread_id = (started.get("thread") or {}).get("id")
        if not self.thread_id:
            raise SystemExit("app-server thread/start returned no thread id")

    def _read_stdout(self) -> None:
        if self.proc is None or self.proc.stdout is None:
            return
        for line in self.proc.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                self.inbox.put(json.loads(line))
            except json.JSONDecodeError:
                if self.verbose:
                    print(f"app-server: {line[:400]}", file=sys.stderr)

    def _read_stderr(self) -> None:
        if self.proc is None or self.proc.stderr is None:
            return
        for line in self.proc.stderr:
            if self.verbose:
                print(f"app-server stderr: {line.rstrip()}", file=sys.stderr)

    def _write(self, message: dict) -> None:
        if self.proc is None or self.proc.stdin is None:
            raise RuntimeError("codex app-server is not running")
        self.proc.stdin.write(json.dumps(message) + "\n")
        self.proc.stdin.flush()

    def notify(self, method: str, params: dict | None = None) -> None:
        self._write({"method": method, "params": params or {}})

    def request(self, method: str, params: dict | None = None, timeout: float = DEFAULT_TIMEOUT) -> dict:
        with self.lock:
            self.next_id += 1
            rid = self.next_id
            self._write({"id": rid, "method": method, "params": params or {}})
            deadline = time.time() + timeout
            while time.time() < deadline:
                if self.proc and self.proc.poll() is not None:
                    raise SystemExit(f"codex app-server exited with code {self.proc.returncode}")
                try:
                    message = self.inbox.get(timeout=0.5)
                except queue.Empty:
                    continue
                if message.get("id") == rid and ("result" in message or "error" in message):
                    if "error" in message:
                        raise RuntimeError(json.dumps(message["error"]))
                    return message["result"]
                if message.get("method") and message.get("id") is not None:
                    # Server-initiated request; acknowledge so it does not block.
                    self._write({"id": message["id"], "result": {}})
            raise TimeoutError(f"{method} timed out after {timeout:.0f}s")

    def call_tool(self, tool: str, arguments: dict, timeout: float = DEFAULT_TIMEOUT) -> dict:
        return self.request(
            "mcpServer/tool/call",
            {
                "threadId": self.thread_id,
                "server": SERVER_NAME,
                "tool": tool,
                "arguments": arguments,
            },
            timeout=timeout,
        )

    def stop(self) -> None:
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.proc.kill()


def execute(server: AppServer, primed: set[str], payload: dict) -> dict:
    """Run one tool call, priming the app session and resolving --match first."""
    tool = payload["tool"]
    arguments = dict(payload.get("arguments") or {})
    timeout = float(payload.get("timeout") or DEFAULT_TIMEOUT)
    app = arguments.get("app")
    match = payload.get("match")

    needs_state = bool(match) or (
        payload.get("prime", True) and tool in INTERACTION_TOOLS and app and app not in primed
    )
    if needs_state and app:
        state = server.call_tool("get_app_state", {"app": app}, timeout=timeout)
        primed.add(app)
        if match:
            text = result_text(state)
            found = tree_matches(text, match["pattern"], match.get("case_sensitive", False))
            if not found:
                raise RuntimeError(f"no element in {app} matches {match['pattern']!r}")
            if len(found) > 1 and not match.get("first", False):
                listing = "\n".join(f"  {i}\t{l}" for i, l in found[:10])
                raise RuntimeError(
                    f"{len(found)} elements match {match['pattern']!r}; refine it or pass --first:\n{listing}"
                )
            arguments["element_index"] = found[0][0]
    if tool == "get_app_state" and app:
        primed.add(app)
    return server.call_tool(tool, arguments, timeout=timeout)


# ---------------------------------------------------------------------------
# Session daemon
# ---------------------------------------------------------------------------

def _canonical_json(value: object) -> bytes:
    """Encode protocol data deterministically and reject non-finite numbers."""
    try:
        return json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
            allow_nan=False,
        ).encode("utf-8")
    except (TypeError, ValueError) as exc:
        raise IPCError(f"request is not valid JSON data: {exc}") from exc


def _frame(value: object, *, limit: int = IPC_MAX_FRAME) -> bytes:
    encoded = _canonical_json(value) + b"\n"
    if len(encoded) > limit:
        raise IPCError("IPC frame is too large")
    return encoded


def _send_frame(
    conn: socket.socket, value: object, *, limit: int = IPC_MAX_FRAME
) -> None:
    conn.sendall(_frame(value, limit=limit))


def _recv_frame(
    conn: socket.socket, *, limit: int = IPC_MAX_FRAME
) -> dict:
    """Read exactly one bounded JSON object from a stream socket."""
    data = bytearray()
    while len(data) < limit:
        chunk = conn.recv(min(4096, limit - len(data)))
        if not chunk:
            raise IPCError("IPC peer closed before sending a frame")
        newline = chunk.find(b"\n")
        if newline >= 0:
            data.extend(chunk[:newline])
            if chunk[newline + 1 :]:
                raise IPCError("IPC peer sent data after the frame")
            break
        data.extend(chunk)
    else:
        raise IPCError(f"IPC frame exceeds the {limit}-byte size limit")
    if not data:
        raise IPCError("IPC frame is empty")
    try:
        value = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise IPCError(f"IPC frame is not valid JSON: {exc}") from exc
    if not isinstance(value, dict):
        raise IPCError("IPC frame must be a JSON object")
    return value


def _auth_digest(token: bytes, challenge: str, payload: dict) -> str:
    try:
        challenge_bytes = bytes.fromhex(challenge)
    except ValueError as exc:
        raise IPCError("invalid authentication challenge") from exc
    if len(challenge_bytes) != 32:
        raise IPCError("invalid authentication challenge length")
    message = b"codex-cua/ipc-v2\0" + challenge_bytes + b"\0" + _canonical_json(payload)
    return hmac.new(token, message, hashlib.sha256).hexdigest()


def _server_proof(token: bytes, challenge: str) -> str:
    try:
        challenge_bytes = bytes.fromhex(challenge)
    except ValueError as exc:
        raise IPCError("invalid authentication challenge") from exc
    if len(challenge_bytes) != 32:
        raise IPCError("invalid authentication challenge length")
    return hmac.new(
        token, b"codex-cua/server-v2\0" + challenge_bytes, hashlib.sha256
    ).hexdigest()


def _validate_match(match: object) -> None:
    if not isinstance(match, dict) or not set(match) <= {"pattern", "case_sensitive", "first"}:
        raise IPCError("match must contain only pattern, case_sensitive, and first")
    pattern = match.get("pattern")
    if not isinstance(pattern, str) or len(pattern) > IPC_MAX_MATCH_PATTERN:
        raise IPCError(f"match pattern must be at most {IPC_MAX_MATCH_PATTERN} characters")
    for name in ("case_sensitive", "first"):
        if name in match and not isinstance(match[name], bool):
            raise IPCError(f"match {name} must be a boolean")
    try:
        re.compile(pattern)
    except re.error as exc:
        raise IPCError(f"match pattern is invalid: {exc}") from exc


def _validate_tool_request(payload: dict) -> None:
    tool = payload.get("tool")
    if tool not in TOOLS:
        raise IPCError(f"unknown tool {tool!r}")
    if not set(payload) <= {"tool", "arguments", "timeout", "prime", "match"}:
        raise IPCError("unsupported tool request fields")
    if "prime" in payload and not isinstance(payload["prime"], bool):
        raise IPCError("prime must be a boolean")
    arguments = payload.get("arguments")
    if not isinstance(arguments, dict):
        raise IPCError("tool arguments must be a JSON object")
    missing = [name for name in TOOLS[tool] if name not in arguments]
    if missing:
        raise IPCError(f"{tool} requires: {', '.join(missing)}")
    timeout = payload.get("timeout", DEFAULT_TIMEOUT)
    if isinstance(timeout, bool) or not isinstance(timeout, (int, float)) or not 0 < float(timeout) <= IPC_MAX_TIMEOUT:
        raise IPCError(f"timeout must be between 0 and {IPC_MAX_TIMEOUT:.0f} seconds")
    if "match" in payload:
        _validate_match(payload["match"])


def _validate_request(payload: dict) -> None:
    """Keep the authenticated daemon surface limited to supported operations."""
    op = payload.get("op")
    if op in {"ping", "shutdown"}:
        if set(payload) != {"op"}:
            raise IPCError(f"unsupported fields for {op}")
        return
    _validate_tool_request(payload)


def _open_lock() -> int:
    path = lock_path()
    fd = _private_file_fd(path, os.O_RDWR | os.O_CREAT, repair_mode=True)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError) as exc:
        os.close(fd)
        if isinstance(exc, BlockingIOError) or getattr(exc, "errno", None) in {11, 35}:
            raise IPCError("session daemon is already starting or running") from exc
        raise IPCError(f"cannot lock session state: {exc}") from exc
    return fd


def _validate_inherited_lock(fd: int) -> None:
    """Ensure a startup fd really names this user's private lock file."""
    try:
        expected = os.lstat(lock_path())
        actual = os.fstat(fd)
    except OSError as exc:
        raise IPCError("cannot inspect daemon startup lock") from exc
    if stat.S_ISLNK(expected.st_mode) or (actual.st_dev, actual.st_ino) != (expected.st_dev, expected.st_ino):
        raise IPCError("daemon startup lock does not name session.lock")
    if not stat.S_ISREG(actual.st_mode) or actual.st_uid != os.getuid() or stat.S_IMODE(actual.st_mode) != PRIVATE_FILE_MODE:
        raise IPCError("daemon startup lock is not private")


def _read_endpoint(endpoint: Path) -> dict:
    try:
        raw = _read_private(endpoint, limit=16 * 1024)
    except IPCError as exc:
        if not endpoint.exists():
            raise FileNotFoundError(endpoint) from exc
        raise
    try:
        document = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise IPCError(f"session endpoint is invalid: {endpoint}") from exc
    if not isinstance(document, dict) or document.get("version") != IPC_VERSION:
        raise IPCError("unsupported session endpoint version")
    return document


def _endpoint_fields(document: dict) -> tuple[int, str, str]:
    try:
        pid = document["pid"]
        socket_value = document["socket"]
        auth_value = document["auth"]
    except KeyError as exc:
        raise IPCError("session endpoint is incomplete") from exc
    if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0:
        raise IPCError("session endpoint has an invalid pid")
    if not isinstance(socket_value, str) or not isinstance(auth_value, str):
        raise IPCError("session endpoint has invalid paths")
    if "\x00" in socket_value or "\x00" in auth_value:
        raise IPCError("session endpoint paths contain a NUL byte")
    return pid, socket_value, auth_value


def _validate_raw_endpoint_paths(raw_socket: Path, raw_auth: Path) -> None:
    if raw_socket.parent != raw_auth.parent:
        raise IPCError("session endpoint paths are not in one directory")
    try:
        raw_session_info = os.lstat(raw_socket.parent)
    except OSError as exc:
        raise IPCError("session directory is unavailable") from exc
    if stat.S_ISLNK(raw_session_info.st_mode):
        raise IPCError("session directory must not be a symlink")
    try:
        raw_socket_info = os.lstat(raw_socket)
    except FileNotFoundError:
        raise FileNotFoundError(raw_socket)
    except OSError as exc:
        raise IPCError("session socket is unavailable") from exc
    if stat.S_ISLNK(raw_socket_info.st_mode):
        raise IPCError("session socket must not be a symlink")
    try:
        raw_auth_info = os.lstat(raw_auth)
    except OSError as exc:
        raise IPCError("session authentication file is unavailable") from exc
    if stat.S_ISLNK(raw_auth_info.st_mode):
        raise IPCError("session authentication file must not be a symlink")


def _resolve_endpoint_paths(document: dict, root: Path) -> tuple[int, Path, Path]:
    pid, socket_value, auth_value = _endpoint_fields(document)
    # macOS commonly exposes /var/folders through a /private symlink. Compare
    # canonical paths so the endpoint we wrote can be loaded on either spelling.
    if not Path(socket_value).is_absolute() or not Path(auth_value).is_absolute():
        raise IPCError("session endpoint paths must be absolute")
    raw_socket = Path(socket_value)
    raw_auth = Path(auth_value)
    _validate_raw_endpoint_paths(raw_socket, raw_auth)
    root = Path(os.path.realpath(root))
    socket_path = Path(os.path.realpath(socket_value))
    auth_path = Path(os.path.realpath(auth_value))
    try:
        socket_path.relative_to(root)
        auth_path.relative_to(root)
    except ValueError as exc:
        raise IPCError("session endpoint escapes the private state directory") from exc
    if socket_path.parent != auth_path.parent or not socket_path.parent.name.startswith(".s-"):
        raise IPCError("session endpoint paths are not in one random session directory")
    if len(os.fsencode(str(socket_path))) >= UNIX_SOCKET_PATH_MAX:
        raise IPCError("session socket path is too long")
    session_dir = socket_path.parent
    _private_stat(session_dir, directory=True)
    if socket_path.name != "session.sock" or auth_path.name != "auth.token":
        raise IPCError("session endpoint has unexpected file names")
    return pid, socket_path, auth_path


def _read_session_token(auth_path: Path) -> bytes:
    try:
        token_text = _read_private(auth_path, limit=128).decode("ascii", "strict").strip()
    except UnicodeDecodeError as exc:
        raise IPCError("session authentication token is not ASCII") from exc
    if not re.fullmatch(r"[0-9a-fA-F]{64}", token_text):
        raise IPCError("session authentication token is invalid")
    try:
        token = bytes.fromhex(token_text)
    except ValueError as exc:
        raise IPCError("session authentication token is invalid") from exc
    if len(token) != 32:
        raise IPCError("session authentication token has invalid length")
    return token


def _validate_session_socket(socket_path: Path) -> None:
    try:
        socket_info = os.lstat(socket_path)
    except FileNotFoundError:
        # The daemon may be between bind and endpoint publication. Let callers
        # treat this as a dead session, while keeping endpoint parsing strict.
        raise FileNotFoundError(socket_path)
    if (
        not stat.S_ISSOCK(socket_info.st_mode)
        or socket_info.st_uid != os.getuid()
        or socket_info.st_nlink != 1
    ):
        raise IPCError("session socket has unexpected type or owner")
    if stat.S_IMODE(socket_info.st_mode) != PRIVATE_FILE_MODE:
        raise IPCError("session socket is not mode 0600")


def _load_session() -> SessionInfo:
    endpoint = endpoint_path()
    document = _read_endpoint(endpoint)
    pid, socket_path, auth_path = _resolve_endpoint_paths(document, Path(os.path.realpath(state_dir())))
    token = _read_session_token(auth_path)
    _validate_session_socket(socket_path)
    session_dir = socket_path.parent
    return SessionInfo(endpoint, session_dir, socket_path, auth_path, pid, token)


def _create_session() -> tuple[SessionInfo, socket.socket]:
    root = state_dir()
    session_dir = None
    for _ in range(8):
        candidate = root / f".s-{secrets.token_hex(6)}"
        if len(os.fsencode(str(candidate / "session.sock"))) >= UNIX_SOCKET_PATH_MAX:
            raise IPCError("CODEX_CUA_HOME is too long for a macOS Unix socket")
        try:
            candidate.mkdir(mode=PRIVATE_DIR_MODE)
        except FileExistsError:
            continue
        session_dir = candidate
        break
    if session_dir is None:
        raise IPCError("could not allocate a random session directory")
    os.chmod(session_dir, PRIVATE_DIR_MODE, follow_symlinks=False)
    auth_path = session_dir / "auth.token"
    socket_path = session_dir / "session.sock"
    endpoint = endpoint_path()
    token = secrets.token_bytes(32)
    listener: socket.socket | None = None
    try:
        _write_private(auth_path, token.hex().encode("ascii") + b"\n")
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        listener.bind(str(socket_path))
        # Do not follow a path swap while applying the socket mode.
        os.chmod(socket_path, PRIVATE_FILE_MODE, follow_symlinks=False)
        listener.listen(8)
        document = {
            "version": IPC_VERSION,
            "pid": os.getpid(),
            "socket": str(socket_path),
            "auth": str(auth_path),
        }
        _write_private(endpoint, _canonical_json(document) + b"\n", replace=True)
        _write_private(pid_path(), f"{os.getpid()}\n".encode(), replace=True)
        return SessionInfo(endpoint, session_dir, socket_path, auth_path, os.getpid(), token), listener
    except Exception:
        if listener is not None:
            listener.close()
        _unlink_best_effort(socket_path)
        _unlink_best_effort(auth_path)
        try:
            session_dir.rmdir()
        except (OSError, IPCError):
            pass
        raise


def _cleanup_session(session: SessionInfo, listener: socket.socket | None = None) -> None:
    if listener is not None:
        listener.close()
    try:
        current = _load_session()
    except (FileNotFoundError, IPCError):
        current = None
    owns_endpoint = bool(
        current
        and os.path.realpath(current.socket_path) == os.path.realpath(session.socket_path)
        and current.pid == session.pid
        and hmac.compare_digest(current.token, session.token)
    )
    if owns_endpoint:
        _unlink_best_effort(session.endpoint)
        try:
            if _read_private(pid_path(), limit=64).decode().strip() == str(session.pid):
                _unlink_best_effort(pid_path())
        except (IPCError, UnicodeDecodeError, FileNotFoundError):
            pass
    _unlink_best_effort(session.socket_path)
    _unlink_best_effort(session.auth_path)
    try:
        session.session_dir.rmdir()
    except OSError:
        pass


def _server_handshake(conn: socket.socket, session: SessionInfo) -> dict:
    conn.settimeout(IPC_AUTH_TIMEOUT)
    identity = peer_identity(conn)
    authorize_peer(identity)
    challenge = secrets.token_hex(32)
    _send_frame(
        conn,
        {
            "version": IPC_VERSION,
            "challenge": challenge,
            "proof": _server_proof(session.token, challenge),
        },
    )
    try:
        envelope = _recv_frame(conn)
    except IPCError as exc:
        raise PeerAuthenticationError("malformed authentication envelope") from exc
    payload = envelope.get("payload")
    mac = envelope.get("mac")
    if set(envelope) != {"payload", "mac"} or not isinstance(payload, dict) or not isinstance(mac, str):
        raise PeerAuthenticationError("malformed authentication envelope")
    try:
        expected = _auth_digest(session.token, challenge, payload)
    except IPCError as exc:
        raise PeerAuthenticationError("malformed authentication envelope") from exc
    if not hmac.compare_digest(mac, expected):
        raise PeerAuthenticationError("request authentication failed")
    _validate_request(payload)
    return payload


def _client_handshake(conn: socket.socket, session: SessionInfo, payload: dict) -> None:
    conn.settimeout(IPC_AUTH_TIMEOUT)
    identity = peer_identity(conn)
    authorize_peer(identity, expected_pid=session.pid)
    try:
        hello = _recv_frame(conn)
    except IPCError as exc:
        raise PeerAuthenticationError("malformed daemon handshake") from exc
    if (
        set(hello) != {"version", "challenge", "proof"}
        or hello.get("version") != IPC_VERSION
        or not isinstance(hello.get("challenge"), str)
        or not isinstance(hello.get("proof"), str)
    ):
        raise PeerAuthenticationError("unsupported daemon handshake")
    expected_proof = _server_proof(session.token, hello["challenge"])
    if not hmac.compare_digest(hello["proof"], expected_proof):
        raise PeerAuthenticationError("daemon authentication failed")
    _send_frame(conn, {"payload": payload, "mac": _auth_digest(session.token, hello["challenge"], payload)})


def _reply_timeout(payload: dict) -> float:
    """Return a bounded write timeout for an authenticated request reply."""
    if payload.get("op") in {"ping", "shutdown"}:
        return IPC_AUTH_TIMEOUT
    # _validate_request has already checked this value before this helper runs.
    return float(payload.get("timeout", DEFAULT_TIMEOUT)) + IPC_AUTH_TIMEOUT


def daemon_send(payload: dict, timeout: float, session: SessionInfo | None = None) -> dict:
    _validate_request(payload)
    session = session or _load_session()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        # Connecting and authenticating must not inherit a caller-controlled
        # operation timeout. A stale or hostile endpoint gets five seconds.
        conn.settimeout(IPC_AUTH_TIMEOUT)
        conn.connect(str(session.socket_path))
        _client_handshake(conn, session, payload)
        conn.settimeout(timeout + 15)
        reply = _recv_frame(conn, limit=IPC_MAX_REPLY_FRAME)
    if not isinstance(reply.get("ok"), bool):
        raise IPCError("daemon returned an invalid response")
    return reply


def daemon_alive() -> bool:
    try:
        session = _load_session()
    except (FileNotFoundError, IPCError):
        return False
    try:
        reply = daemon_send({"op": "ping"}, 2, session)
    except (ConnectionError, FileNotFoundError, IPCError, TimeoutError, BrokenPipeError):
        return False
    return reply.get("ok") is True


def _daemon_lock_from_environment() -> int:
    inherited = os.environ.pop(START_LOCK_FD_ENV, "")
    if inherited:
        try:
            fd = int(inherited)
            os.fstat(fd)
            _validate_inherited_lock(fd)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError as exc:
                raise IPCError("daemon startup lock is not held") from exc
            return fd
        except (OSError, ValueError) as exc:
            raise IPCError("invalid daemon startup lock") from exc
    return _open_lock()


def _handle_daemon_connection(
    conn: socket.socket,
    session: SessionInfo,
    server: AppServer,
    primed: set[str],
) -> bool:
    """Authenticate and serve one request. Return true for an authorized stop."""
    try:
        payload = _server_handshake(conn, session)
        if payload.get("op") == "ping":
            reply = {"ok": True, "thread": server.thread_id, "pid": os.getpid()}
        elif payload.get("op") == "shutdown":
            conn.settimeout(IPC_AUTH_TIMEOUT)
            _send_frame(conn, {"ok": True})
            return True
        else:
            reply = {"ok": True, "result": execute(server, primed, payload)}
        # Keep a slow client from blocking the daemon forever, while allowing
        # enough time for the largest bounded screenshot reply.
        conn.settimeout(_reply_timeout(payload))
        _send_frame(conn, reply, limit=IPC_MAX_REPLY_FRAME)
    except PeerAuthenticationError:
        # Do not reveal whether the token, peer identity, or endpoint was wrong.
        try:
            conn.settimeout(IPC_AUTH_TIMEOUT)
            _send_frame(conn, {"ok": False, "error": "unauthorized"})
        except (OSError, IPCError):
            pass
    except Exception as exc:  # noqa: BLE001 - report every failure to the client
        message = str(exc) if isinstance(exc, (RuntimeError, SystemExit)) else f"{type(exc).__name__}: {exc}"
        try:
            conn.settimeout(IPC_AUTH_TIMEOUT)
            _send_frame(conn, {"ok": False, "error": message})
        except OSError:
            pass
    return False


def run_daemon(verbose: bool) -> None:
    lock_fd = _daemon_lock_from_environment()
    server = AppServer(verbose=verbose)
    session: SessionInfo | None = None
    listener: socket.socket | None = None
    try:
        server.start()
        session, listener = _create_session()
        primed: set[str] = set()

        def shutdown(*_args):
            _cleanup_session(session, listener)
            server.stop()
            os.close(lock_fd)
            os._exit(0)

        signal.signal(signal.SIGTERM, shutdown)
        signal.signal(signal.SIGINT, shutdown)
        while True:
            conn, _ = listener.accept()
            with conn:
                if _handle_daemon_connection(conn, session, server, primed):
                    shutdown()
                    return
    finally:
        if session is not None:
            _cleanup_session(session, listener)
        server.stop()
        os.close(lock_fd)


def ensure_daemon(verbose: bool) -> None:
    if daemon_alive():
        return
    lock_fd = _open_lock()
    child = None
    try:
        if daemon_alive():
            return
        log_path_value = log_path()
        log_fd = _private_file_fd(
            log_path_value, os.O_WRONLY | os.O_CREAT | os.O_APPEND, repair_mode=True
        )
        env = os.environ.copy()
        env[START_LOCK_FD_ENV] = str(lock_fd)
        try:
            child = subprocess.Popen(
                [sys.executable, os.path.abspath(__file__), "daemon", "run"] + (["--verbose"] if verbose else []),
                stdin=subprocess.DEVNULL,
                stdout=log_fd,
                stderr=log_fd,
                start_new_session=True,
                pass_fds=(lock_fd,),
                env=env,
            )
        finally:
            os.close(log_fd)
        # The lock is inherited by the child. Closing this descriptor leaves the
        # lock held while AppServer starts, preventing duplicate daemons.
        os.close(lock_fd)
        lock_fd = -1
    except Exception:
        if child is not None and child.poll() is None:
            child.terminate()
        raise
    finally:
        if lock_fd >= 0:
            os.close(lock_fd)
    deadline = time.monotonic() + 90
    while time.monotonic() < deadline:
        try:
            if daemon_alive():
                return
        except IPCError:
            pass
        time.sleep(0.2)
    raise SystemExit(f"session daemon failed to start; see {log_path()}")


# ---------------------------------------------------------------------------
# Tool invocation
# ---------------------------------------------------------------------------


def invoke(tool: str, arguments: dict, opts: argparse.Namespace) -> dict:
    arguments = {k: v for k, v in arguments.items() if v is not None}
    timeout = float(getattr(opts, "timeout", DEFAULT_TIMEOUT))
    payload = {
        "tool": tool,
        "arguments": arguments,
        "timeout": timeout,
        "prime": not getattr(opts, "no_prime", False),
    }
    pattern = getattr(opts, "match", None)
    if pattern:
        payload["match"] = {
            "pattern": pattern,
            "case_sensitive": getattr(opts, "case_sensitive", False),
            "first": getattr(opts, "first", False),
        }
    if getattr(opts, "no_daemon", False):
        server = AppServer(verbose=opts.verbose)
        server.start()
        try:
            return execute(server, set(), payload)
        finally:
            server.stop()
    ensure_daemon(opts.verbose)
    reply = daemon_send(payload, timeout)
    if not reply.get("ok"):
        raise SystemExit(reply.get("error", "unknown session daemon error"))
    return reply["result"]


def result_text(result: dict) -> str:
    return "\n".join(
        block.get("text", "")
        for block in (result.get("content") or [])
        if block.get("type") == "text"
    )


def result_images(result: dict) -> list[bytes]:
    return [
        base64.b64decode(block["data"])
        for block in (result.get("content") or [])
        if block.get("type") == "image" and block.get("data")
    ]


def emit(result: dict, opts: argparse.Namespace, *, print_text: bool = True) -> int:
    if getattr(opts, "quiet", False):
        print_text = False
    if getattr(opts, "json", False):
        print(json.dumps(result, indent=2))
    elif print_text:
        text = result_text(result)
        if text:
            print(text)
    out = getattr(opts, "out", None)
    images = result_images(result)
    if out and images:
        target = Path(out)
        if target.is_dir() or out.endswith("/"):
            target.mkdir(parents=True, exist_ok=True)
            paths = [target / f"screenshot-{i}.png" if i else target / "screenshot.png" for i in range(len(images))]
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            paths = [target if i == 0 else target.with_name(f"{target.stem}-{i}{target.suffix}") for i in range(len(images))]
        for path, data in zip(paths, images):
            path.write_bytes(data)
            print(f"screenshot: {path}", file=sys.stderr)
    elif images and not getattr(opts, "quiet", False):
        print(f"({len(images)} screenshot(s) returned; pass --out FILE to save)", file=sys.stderr)
    return 1 if result.get("isError") else 0


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------


def cmd_apps(opts):
    return emit(invoke("list_apps", {}, opts), opts)


def cmd_state(opts):
    return emit(invoke("get_app_state", {"app": opts.app}, opts), opts)


def cmd_find(opts):
    result = invoke("get_app_state", {"app": opts.app}, opts)
    matches = tree_matches(result_text(result), opts.pattern, opts.case_sensitive)
    if opts.json:
        print(json.dumps([{"element_index": i, "line": l} for i, l in matches], indent=2))
    else:
        for index, line in matches:
            print(f"{index}\t{line}")
    if not matches:
        print(f"no elements matching {opts.pattern!r}", file=sys.stderr)
        return 1
    return 0


def cmd_screenshot(opts):
    result = invoke("get_app_state", {"app": opts.app}, opts)
    return emit(result, opts, print_text=False)


def require_target(opts, command: str) -> None:
    if not opts.element and not opts.match:
        raise SystemExit(f"{command} needs --element INDEX or --match REGEX")
    if opts.element and opts.match:
        raise SystemExit("--element and --match are mutually exclusive")


def cmd_click(opts):
    if opts.element is None and opts.match is None and (opts.x is None or opts.y is None):
        raise SystemExit("click needs --element INDEX, --match REGEX, or both --x and --y")
    args = {
        "app": opts.app,
        "element_index": opts.element,
        "x": opts.x,
        "y": opts.y,
        "click_count": opts.count,
        "mouse_button": opts.button,
    }
    return emit(invoke("click", args, opts), opts)


def cmd_type(opts):
    return emit(invoke("type_text", {"app": opts.app, "text": opts.text}, opts), opts)


def cmd_key(opts):
    return emit(invoke("press_key", {"app": opts.app, "key": opts.key}, opts), opts)


def cmd_scroll(opts):
    require_target(opts, "scroll")
    args = {
        "app": opts.app,
        "element_index": opts.element,
        "direction": opts.direction,
        "pages": opts.pages,
    }
    return emit(invoke("scroll", args, opts), opts)


def parse_point(value: str, flag: str) -> tuple[float, float]:
    parts = value.replace(" ", "").split(",")
    if len(parts) != 2:
        raise SystemExit(f"{flag} expects X,Y")
    try:
        return float(parts[0]), float(parts[1])
    except ValueError:
        raise SystemExit(f"{flag} expects numeric X,Y")


def cmd_drag(opts):
    fx, fy = parse_point(opts.start, "--from")
    tx, ty = parse_point(opts.end, "--to")
    args = {"app": opts.app, "from_x": fx, "from_y": fy, "to_x": tx, "to_y": ty}
    return emit(invoke("drag", args, opts), opts)


def cmd_set_value(opts):
    require_target(opts, "set-value")
    args = {"app": opts.app, "element_index": opts.element, "value": opts.value}
    return emit(invoke("set_value", args, opts), opts)


def cmd_select_text(opts):
    require_target(opts, "select-text")
    args = {
        "app": opts.app,
        "element_index": opts.element,
        "text": opts.text,
        "prefix": opts.prefix,
        "suffix": opts.suffix,
        "selection": opts.selection,
    }
    return emit(invoke("select_text", args, opts), opts)


def cmd_action(opts):
    require_target(opts, "action")
    args = {"app": opts.app, "element_index": opts.element, "action": opts.action}
    return emit(invoke("perform_secondary_action", args, opts), opts)


def cmd_call(opts):
    if opts.tool not in TOOLS:
        raise SystemExit(f"unknown tool {opts.tool!r}; known tools: {', '.join(sorted(TOOLS))}")
    try:
        arguments = json.loads(opts.arguments) if opts.arguments else {}
    except json.JSONDecodeError as exc:
        raise SystemExit(f"arguments must be JSON: {exc}")
    missing = [k for k in TOOLS[opts.tool] if k not in arguments]
    if missing:
        raise SystemExit(f"{opts.tool} requires: {', '.join(missing)}")
    return emit(invoke(opts.tool, arguments, opts), opts)


def cmd_tools(opts):
    for name, required in sorted(TOOLS.items()):
        print(f"{name}\trequired: {', '.join(required) or '(none)'}")
    return 0


def cmd_daemon(opts):
    if opts.action == "run":
        run_daemon(opts.verbose)
        return 0
    if opts.action == "start":
        ensure_daemon(opts.verbose)
        session = _load_session()
        print(f"session daemon running (pid {session.pid}), socket {session.socket_path}")
        return 0
    if opts.action == "status":
        if daemon_alive():
            session = _load_session()
            info = daemon_send({"op": "ping"}, 10, session)
            info["socket"] = str(session.socket_path)
            print(json.dumps(info, indent=2))
            return 0
        print("session daemon not running")
        return 1
    if opts.action == "stop":
        if not daemon_alive():
            print("session daemon not running")
            return 0
        try:
            daemon_send({"op": "shutdown"}, 10)
        except (OSError, IPCError):
            pass
        print("session daemon stopped")
        return 0
    if opts.action == "restart":
        opts.action = "stop"
        cmd_daemon(opts)
        opts.action = "start"
        return cmd_daemon(opts)
    raise SystemExit(f"unknown daemon action {opts.action}")


def _doctor_prerequisites(check) -> bool:
    codex_ok = False
    try:
        codex = codex_bin()
        check("codex CLI", True, codex)
        codex_ok = True
    except SystemExit as exc:
        check("codex CLI", False, str(exc))
        codex = None
    if codex:
        try:
            signing = subprocess.run(
                ["/usr/bin/codesign", "-dv", "--verbose=2", codex],
                capture_output=True,
                text=True,
                timeout=20,
                check=False,
            ).stderr
            team = next((l.split("=", 1)[1] for l in signing.splitlines() if l.startswith("TeamIdentifier=")), "")
            check(
                "codex signed by OpenAI",
                team == OPENAI_TEAM_ID,
                team or "no team identifier (Computer Use will reject this host process)",
            )
            codex_ok = team == OPENAI_TEAM_ID
        except Exception as exc:  # noqa: BLE001
            check("codex signature", False, str(exc))
    bundle_ok = False
    try:
        app = computer_use_app()
        check("Computer Use bundle", True, str(app))
        client = mcp_client_path(app)
        bundle_ok = client.is_file()
        check("MCP client binary", bundle_ok, str(client))
    except SystemExit as exc:
        check("Computer Use bundle", False, str(exc))
    return codex_ok and bundle_ok


def cmd_doctor(opts):
    ok = True

    def check(label: str, good: bool, detail: str) -> None:
        nonlocal ok
        ok = ok and good
        print(f"{'pass' if good else 'FAIL'}  {label}: {detail}")

    prerequisites_ok = _doctor_prerequisites(check)
    ok = ok and prerequisites_ok

    try:
        session = _load_session()
    except (FileNotFoundError, IPCError):
        session = None
    if session and daemon_alive():
        print(f"info  session daemon: authenticated (pid {session.pid}, socket {session.socket_path})")
    else:
        print("info  session daemon: not running (starts on demand)")
    if ok:
        try:
            result = invoke("list_apps", {}, opts)
            lines = [l for l in result_text(result).splitlines() if l.strip()]
            check("list_apps", not result.get("isError"), f"{len(lines)} apps visible")
        except Exception as exc:  # noqa: BLE001
            check("list_apps", False, str(exc))
            ok = False

    if not ok:
        print(
            "\nIf list_apps reports 'Sender process is not authenticated', the Computer Use "
            "service rejected the host process. Only an OpenAI-signed parent (the codex CLI) "
            "may host the MCP server, so make sure CODEX_BIN points at the bundled binary.",
            file=sys.stderr,
        )
    return 0 if ok else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="codex-cua",
        description="Drive local macOS apps through Codex Computer Use.",
    )
    parser.add_argument("--version", action="version", version=VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="print the raw MCP result")
    common.add_argument("--out", help="write returned screenshots to this file or directory")
    common.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="per-tool timeout in seconds")
    common.add_argument("--no-daemon", action="store_true", help="run a throwaway app-server instead of the session daemon")
    common.add_argument("--no-prime", action="store_true", help="skip the automatic get_app_state before an interaction")
    common.add_argument("--quiet", "-q", action="store_true", help="suppress tree output, keep --out screenshots")
    common.add_argument("--verbose", "-v", action="store_true", help="log app-server output")

    # Element selection. Indices are only valid inside one snapshot, so --match
    # resolves against a fresh tree in the same round trip.
    target = argparse.ArgumentParser(add_help=False)
    target.add_argument("--element", "-e", help="element index from the accessibility tree")
    target.add_argument("--match", "-m", help="regex matched against tree lines to pick the element")
    target.add_argument("--case-sensitive", action="store_true", help="make --match case sensitive")
    target.add_argument("--first", action="store_true", help="use the first --match hit instead of failing on ambiguity")

    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("apps", parents=[common], help="list running and recent apps")
    p.set_defaults(func=cmd_apps)

    p = sub.add_parser("state", parents=[common], help="accessibility tree + screenshot for an app")
    p.add_argument("app")
    p.set_defaults(func=cmd_state)

    p = sub.add_parser("find", parents=[common], help="grep the accessibility tree for element indices")
    p.add_argument("app")
    p.add_argument("pattern")
    p.add_argument("--case-sensitive", action="store_true")
    p.set_defaults(func=cmd_find)

    p = sub.add_parser("screenshot", parents=[common], help="save a screenshot of the app's key window")
    p.add_argument("app")
    p.set_defaults(func=cmd_screenshot)

    p = sub.add_parser("click", parents=[common, target], help="click an element or pixel coordinate")
    p.add_argument("app")
    p.add_argument("--x", type=float)
    p.add_argument("--y", type=float)
    p.add_argument("--count", type=int, help="number of clicks")
    p.add_argument("--button", choices=["left", "right", "middle"])
    p.set_defaults(func=cmd_click)

    p = sub.add_parser("type", parents=[common], help="type literal text")
    p.add_argument("app")
    p.add_argument("text")
    p.set_defaults(func=cmd_type)

    p = sub.add_parser("key", parents=[common], help="press a key or chord (xdotool syntax, e.g. super+c)")
    p.add_argument("app")
    p.add_argument("key")
    p.set_defaults(func=cmd_key)

    p = sub.add_parser("scroll", parents=[common, target], help="scroll an element")
    p.add_argument("app")
    p.add_argument("--direction", "-d", required=True, choices=["up", "down", "left", "right"])
    p.add_argument("--pages", type=float)
    p.set_defaults(func=cmd_scroll)

    p = sub.add_parser("drag", parents=[common], help="drag between two pixel coordinates")
    p.add_argument("app")
    p.add_argument("--from", dest="start", required=True, metavar="X,Y")
    p.add_argument("--to", dest="end", required=True, metavar="X,Y")
    p.set_defaults(func=cmd_drag)

    p = sub.add_parser("set-value", parents=[common, target], help="set a settable element's value")
    p.add_argument("app")
    p.add_argument("value")
    p.set_defaults(func=cmd_set_value)

    p = sub.add_parser("select-text", parents=[common, target], help="select text or place the cursor in a text element")
    p.add_argument("app")
    p.add_argument("text")
    p.add_argument("--prefix")
    p.add_argument("--suffix")
    p.add_argument("--selection", choices=["text", "cursor_before", "cursor_after"])
    p.set_defaults(func=cmd_select_text)

    p = sub.add_parser("action", parents=[common, target], help="invoke a secondary accessibility action")
    p.add_argument("app")
    p.add_argument("action")
    p.set_defaults(func=cmd_action)

    p = sub.add_parser("call", parents=[common], help="call any Computer Use tool with raw JSON arguments")
    p.add_argument("tool")
    p.add_argument("arguments", nargs="?", default="{}")
    p.set_defaults(func=cmd_call)

    p = sub.add_parser("tools", parents=[common], help="list the Computer Use tools and their required arguments")
    p.set_defaults(func=cmd_tools)

    p = sub.add_parser("daemon", parents=[common], help="manage the background session daemon")
    p.add_argument("action", choices=["start", "stop", "restart", "status", "run"])
    p.set_defaults(func=cmd_daemon)

    p = sub.add_parser("doctor", parents=[common], help="check the Computer Use setup end to end")
    p.set_defaults(func=cmd_doctor)

    return parser


def main(argv: list[str]) -> int:
    if sys.platform != "darwin":
        raise SystemExit("codex-cua only works on macOS")
    opts = build_parser().parse_args(argv)
    try:
        return opts.func(opts)
    except KeyboardInterrupt:
        return 130
    except (RuntimeError, TimeoutError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
